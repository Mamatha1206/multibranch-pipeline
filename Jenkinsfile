    agent any

    stages {
        stage('Build') {
            steps {
                echo "Building on prod branch"
            }
        }
        stage('Final Test') {
            steps {
                echo "Running final production tests"
            }
        }
        stage('Deploy to Production') {
            steps {
                echo "Deploying to production..."
            }
        }
    }
}

    
